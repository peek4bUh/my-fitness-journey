<aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
  class="fixed left-0 top-14 z-50 flex h-screen w-2xs px-4 flex-col border-r border-gray-200 bg-white transition-all duration-300 lg:static lg:translate-x-0">

  <!-- SIDEBAR HEADER -->
  <div class="hidden lg:flex items-center border-b border-gray-200 h-16">
    <div class="flex items-center gap-3 overflow-hidden">
      <div class="w-8 h-8 bg-gray-900 rounded-lg flex items-center justify-center flex-shrink-0">
        <img class="w-5 h-5" alt="MyFitnessJourney Logo" src="{{ url_for('static', filename='images/logo.svg') }}" />
      </div>
      <h1 x-show="!sidebarCollapsed" class="text-lg font-semibold text-gray-900 whitespace-nowrap">MyFitnessJourney</h1>
    </div>
  </div>

  <!-- SIDEBAR MENU -->
  <nav class="flex-1 overflow-y-auto py-6">
    <ul class="flex flex-col gap-1">
      {% from 'icons/overview.html' import OverviewIcon %}
      {% from 'icons/workouts.html' import WorkoutsIcon %}
      {% from 'icons/programs.html' import ProgramsIcon %}
      {% from 'icons/body-weights.html' import BodyWeightsIcon %}

      {% set sidebar_items = [
      {
      "title": "Overview",
      "href": "/dashboard",
      "icon": OverviewIcon()
      },
      {
      "title": "Workouts",
      "href": "#",
      "icon": WorkoutsIcon()
      },
      {
      "title": "Programs",
      "href": "/programs",
      "icon": ProgramsIcon()
      },
      {
      "title": "Body Weights",
      "href": "#",
      "icon": BodyWeightsIcon()
      } ] %}

      {% for item in sidebar_items %}
      <li>
        <a href="{{ item.href }}"
          class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          :class="sidebarCollapsed ? 'justify-center' : ''">
          {{ item.icon }}
          <span x-show="!sidebarCollapsed" class="lg:block">{{ item.title }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
</aside>