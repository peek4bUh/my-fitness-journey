{% extends "layouts/base-dashboard.html.j2" %}

{% block content_dashboard %}
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    {% for program in programs %}
      <div class="flex items-center p-4 border-b border-gray-200 hover:bg-gray-50 transition-colors group">
        <div class="flex-grow min-w-0">
          <a href="{{ url_for("ui.dashboard.dashboard_programs_page") }}/{{ program.id }}"
             class="text-base font-medium text-gray-900 hover:underline cursor-pointer">
            {{ program.title }}
          </a>
          <p class="text-xs text-gray-500 mt-0.5 mb-1">{{ program.duration_weeks }} weeks</p>
          <p class="text-sm text-gray-600 line-clamp-1">{{ program.description }}</p>
        </div>

        <button class="p-2 hover:bg-gray-100 rounded-sm cursor-pointer">
          <svg class="w-5 h-5 text-gray-600">
            <use href="{{ url_for('static', filename='icons.svg') }}#trashcan" />
          </svg>
        </button>
      </div>
    {% endfor %}
  </div>
{% endblock content_dashboard %}
