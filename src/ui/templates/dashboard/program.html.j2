{% extends "layouts/base-dashboard.html.j2" %}

{% block content_dashboard %}
  <div class="space-y-6">
    <!-- Header -->
    <div class="p-6 bg-white border border-gray-200 rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="mb-2 text-2xl font-bold text-gray-900">{{ program.title }}</h1>
        <p class="mb-2 text-sm text-gray-600">{{ program.description }}</p>
        <p class="text-xs text-gray-500">
          Duration: {{ program.duration_weeks }} week{{ 's' if program.duration_weeks|int != 1 }}
        </p>
      </div>
      <button class="self-start inline-flex items-center justify-center bg-gray-900 text-white gap-2 rounded-md text-sm font-medium shadow cursor-pointer h-9 px-3 py-2 w-full sm:w-auto">
        <svg class="w-6 h-6 text-white">
          <use href="{{ url_for('static', filename='icons.svg') }}#plus" />
        </svg>
        Add Section
      </button>
    </div>

    <!-- Sections -->
    {% for section in program.sections or [] %}
      <section class="bg-white border border-gray-200 rounded-lg">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between px-6 py-4.5">
          <div>
            <h2 class="text-lg font-medium text-gray-900 mb-2">{{ section.name }}</h2>
            <p class="text-sm text-gray-600">Day {{ loop.index }}</p>
          </div>
          <div>
            <button class="self-start inline-flex items-center justify-center bg-red-600 text-white gap-2 rounded-md text-sm font-medium shadow cursor-pointer h-9 px-3 py-2 w-full sm:w-auto">
              <svg class="w-6 h-6 text-white">
                <use href="{{ url_for('static', filename='icons.svg') }}#trashcan" />
              </svg>
              Delete Section
            </button>
          </div>
        </div>
        <div>
          <div class="overflow-x-auto">
            <table class="w-full 2xl:table-fixed">
              <thead>
                <tr class="border-y border-gray-200 bg-gray-100">
                  <th class="text-left py-3 px-6 text-sm font-semibold text-gray-700">Exercise</th>
                  <th class="text-center py-3 px-6 text-sm font-semibold text-gray-700">Sets</th>
                  <th class="text-center py-3 px-6 text-sm font-semibold text-gray-700">Reps</th>
                  <th class="text-center py-3 px-6 text-sm font-semibold text-gray-700">RPE</th>
                  <th class="text-center py-3 px-6 text-sm font-semibold text-gray-700">Rest (s)</th>
                  <th class="text-center py-3 px-6 text-sm font-semibold text-gray-700">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for ex in section.exercises %}
                  <tr class="border-b border-gray-100">
                    <td class="py-3 px-6 text-sm text-gray-600 font-medium">{{ ex.name }}</td>
                    <td class="py-3 px-6 text-sm text-gray-600 text-center font-medium">{{ ex.sets }}</td>
                    <td class="py-3 px-6 text-sm text-gray-600 text-center font-medium">{{ ex.reps }}</td>
                    <td class="py-3 px-6 text-sm text-gray-600 text-center font-medium">{{ ex.rpe }}</td>
                    <td class="py-3 px-6 text-sm text-gray-600 text-center font-medium">{{ ex.rest_seconds }}</td>
                    <td class="py-3 px-6 flex items-center justify-center">
                      <button class="p-1 hover:bg-gray-100 rounded-full transition-colors cursor-pointer">
                        <svg class="w-6 h-6 text-gray-900">
                          <use href="{{ url_for('static', filename='icons.svg') }}#plus" />
                        </svg>
                      </button>
                      <button class="p-2 hover:bg-gray-100 rounded-full transition-colors cursor-pointer">
                        <svg class="w-4 h-4 text-gray-900">
                          <use href="{{ url_for('static', filename='icons.svg') }}#pencil" />
                        </svg>
                      </button>
                      <button class="p-1.5 hover:bg-gray-100 rounded-full transition-colors cursor-pointer">
                        <svg class="w-5 h-5 text-gray-900">
                          <use href="{{ url_for('static', filename='icons.svg') }}#trashcan" />
                        </svg>
                      </button>
                      <button class="p-1 hover:bg-gray-100 rounded-full transition-colors cursor-pointer">
                        <svg class="w-6 h-6 text-gray-900">
                          <use href="{{ url_for('static', filename='icons.svg') }}#chevron-up" />
                        </svg>
                      </button>
                      <button class="p-1 hover:bg-gray-100 rounded-full transition-colors cursor-pointer">
                        <svg class="w-6 h-6 text-gray-900">
                          <use href="{{ url_for('static', filename='icons.svg') }}#chevron-down" />
                        </svg>
                      </button>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="py-4 px-6 flex items-center justify-between text-sm text-gray-600">
            <span>{{ section.exercises|length }} exercise{{ 's' if section.exercises|length != 1 }}</span>
          </div>
        </div>
      </section>
    {% endfor %}
  </div>
{% endblock content_dashboard %}
