{% macro Button(variant='text', href=None, name='Button', size='small') -%}

{% if size == 'small' %}
{% set size_classes = 'px-4 py-1.5 text-sm' %}
{% set size_border = 'border' %}
{% elif size == 'medium' %}
{% set size_classes = 'px-6 py-2.5 text-sm' %}
{% set size_border = 'border' %}
{% else %}
{% set size_classes = 'px-10 py-4 text-lg' %}
{% set size_border = 'border-2' %}
{% endif %}

{% if href == None %}
{% set url = '#' %}
{% elif href.startswith('http') or href.startswith('/') %}
{% set url = href %}
{% else %}
{% set url = url_for(href) %}
{% endif %}

{% if variant == 'text' %}
{% set variant_classes = 'rounded-md text-gray-700 hover:bg-gray-200 hover:text-black' %}
{% set border_classes = '' %}
{% elif variant == 'contained' %}
{% set variant_classes = 'bg-black text-white border-black rounded-md hover:bg-gray-800' %}
{% set border_classes = size_border %}
{% else %}
{% set variant_classes = 'text-gray-700 border-black rounded-md hover:bg-gray-200 hover:text-black' %}
{% set border_classes = size_border %}
{% endif %}

<a href="{{ url }}"
    class="{{ variant_classes }} {{ size_classes }} {{ border_classes }} transition-colors duration-200">
    {{ name }}
</a>
{%- endmacro %}